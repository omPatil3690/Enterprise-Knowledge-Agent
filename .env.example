# =================================================================
# Enterprise Knowledge Agent - Environment Configuration Example
# =================================================================
# Copy this file to .env and fill in your credentials:
# cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# 1. NOTION CONNECTOR
# -----------------------------------------------------------------
# Notion Internal Integration / Installation Access Token (secret_... or ntn_...)
# Create one at: https://app.notion.com/developers/connections
NOTION_TOKEN=secret_your_notion_integration_token_here

# Optional: Default target Notion Page UUID for single-page ingestion tests
NOTION_PAGE_ID=2fb3317c-c712-8028-80ea-cdca6646fe1e

# -----------------------------------------------------------------
# 2. FUTURE ENTERPRISE CONNECTORS (Optional)
# -----------------------------------------------------------------
# Atlassian Confluence
CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_USERNAME=your-email@company.com
CONFLUENCE_API_TOKEN=your_confluence_api_token

# Atlassian Jira
# JIRA_URL must point to your actual Jira site (e.g. https://your-org.atlassian.net).
# Do NOT set it to the account portal (https://home.atlassian.com) — that host answers with
# the HTML Atlassian Home page instead of REST JSON, so the connection test can pass while
# every payload JSON parse fails. Create a token at:
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token

# GitHub
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# Dropbox (Person access token; create at https://www.dropbox.com/developers/apps)
DROPBOX_TOKEN=your_dropbox_access_token

# Google Drive
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# -----------------------------------------------------------------
# 3. LLM & EMBEDDING PROVIDERS (For RAG & Agent Reasoning)
# -----------------------------------------------------------------
# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=sk-your_openai_api_key_here

# -----------------------------------------------------------------
# 4. VECTOR DATABASE (For Semantic Chunk Search)
# -----------------------------------------------------------------
# Vector Store Type: qdrant | chromadb
VECTOR_DB_TYPE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_if_cloud

# -----------------------------------------------------------------
# 5. KNOWLEDGE GRAPH DATABASE (For Neo4j Graph RAG)
# -----------------------------------------------------------------
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
